# Variáveis de ambiente para rodar os exemplos executáveis das skills.
# Copie para .env e preencha com credenciais de uma LOJA SANDBOX da Tray.
# NUNCA commitar .env com valores reais (o hook PostToolUse bloqueia literais).

# Host da API da loja — o api_address retornado no callback OAuth (varia por loja).
TRAY_API_BASE=https://api.sualoja.commercesuite.com.br

# Token de acesso (expira em 3 horas). Renove via refresh_token antes de expirar.
TRAY_ACCESS_TOKEN=

# URL da vitrine da loja — usado só no fluxo OAuth (etapa de redirect).
TRAY_STORE_URL=https://sualoja.commercesuite.com.br

# Credenciais do app — usadas só nos exemplos da skill autorizacao.
TRAY_CONSUMER_KEY=
TRAY_CONSUMER_SECRET=

# Fluxo OAuth (skill autorizacao):
# code recebido no callback (etapa 2) e refresh_token (renovação).
TRAY_AUTH_CODE=
TRAY_REFRESH_TOKEN=

# Exemplos de webhook (listener local — não chamam a API Tray).
WEBHOOK_PORT=3000
WEBHOOK_URL=http://localhost:3000

# IDs de recurso usados por exemplos que operam sobre item existente
# (GET /:id, PUT, DELETE). Aponte para recursos de teste na loja sandbox.
TRAY_PRODUCT_ID=
TRAY_VARIANT_ID=
TRAY_ORDER_ID=
TRAY_CUSTOMER_ID=
TRAY_CATEGORY_ID=
TRAY_BRAND_ID=
